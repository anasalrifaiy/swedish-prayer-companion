{
  "expo": {
    "name": "Prayer Sverige",
    "slug": "prayers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-salah.png",
    "scheme": "prayers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Prayer Sverige använder din plats för att välja närmaste svenska tabellstad och visa Qibla."
      },
      "bundleIdentifier": "com.prayers.app"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.prayers.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Prayer Sverige använder din plats för att välja närmaste svenska tabellstad och visa Qibla."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07382F",
          "image": "./assets/images/icon-salah.png",
          "imageWidth": 170
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a4ca81c-1fec-462a-bc7c-8646da1a22d5"
      }
    }
  }
}
